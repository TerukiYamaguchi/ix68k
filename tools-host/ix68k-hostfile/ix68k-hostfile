#!/usr/bin/env python3
"""ix68k-hostfile - 稼働中の ix68k と macOS 間でファイルをやり取りする
人間向け CLI（Issue #39）。MCPの `hostfile(action=...)` ツールとは別に、
ターミナルから直接叩ける薄いソケットクライアント。

依存は標準ライブラリのみ。エミュレータのMCPソケット
（既定 /tmp/ix68k_mcp.sock、環境変数 IX68K_MCP_SOCK または --sock で変更可。
Windowsは 127.0.0.1:26800、環境変数 IX68K_MCP_PORT または --port で変更可、
Issue #185）へ `HOSTFILE GET/PUT/STATUS` を1フレームのコマンドとして送る
（共有 `tools-host/mcp/ix68k_wire.py`、`DISK INSERT` 等と同一レイヤ）。ワイヤの版が
変わるときは共有wire層を更新する。既定ポート値は C 側
`src/mcp/port.h` と共有wire層で同期が要る。

GET/PUT は send/scp 等と同じく「呼び出す側から見た自分の動作」を表す
（PUT=自分から送り出す、GET=自分が受け取る）。絶対方向ラベルではないので、
Human68k側の `HOSTFILE GET/PUT` とは語が逆になる（macOSがPUTしたものを
Human68kがGETで受け取り、Human68kがPUTしたものをmacOSがGETで受け取る）。

使い方:
    ix68k-hostfile put  <macos_path>    ファイルをHuman68k側へ送る（この後 Human68k側で HOSTFILE GET）
    ix68k-hostfile get  <macos_path>    Human68k側が HOSTFILE PUT したファイルを受け取る
    ix68k-hostfile status                転送待ちの状態を表示
"""

import argparse
import os
import sys
import tempfile
from pathlib import Path

# MCP server / GUI と同じ wire 実装を用いる。実行ファイル自身の場所から解決するため、
# カレントディレクトリには依存しない。
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "mcp"))
from ix68k_wire import Request, WireClient, WireError, parse_port

# Windowsに/tmpは無いため%TEMP%を使う（C側のMCPソケットと同じ場所に
# 合流させる、Issue #108）。--sock はプラットフォームに関係なく常に定義する
# （D11）ため、Windowsでも既定値として持っておく（実際に使われるのはmacOS/Linux
# だけだが、明示指定時の警告判定・--helpの表示に使う）。
if sys.platform == "win32":
    _PLATFORM_SOCK = str(Path(tempfile.gettempdir()) / "ix68k_mcp.sock")
else:
    _PLATFORM_SOCK = "/tmp/ix68k_mcp.sock"

# 優先順位: --sock（明示指定） > IX68K_MCP_SOCK（Issue #144） > プラットフォーム既定。
# --sock の default=DEFAULT_SOCK に環境変数を織り込むだけで、argparse側の
# 優先順位はそのまま成立する。
DEFAULT_SOCK = os.environ.get("IX68K_MCP_SOCK") or _PLATFORM_SOCK

# src/mcp/port.h の MCP_DEFAULT_PORT / tools-host/mcp/ix68k_mcp_server.py と一致必須。
_DEFAULT_PORT = 26800


# トランスポートは「エミュレータ側が何をlistenしているか」で決まる。判定は
# hasattr(socket, "AF_UNIX") ではなく sys.platform で行う（Issue #185 D10:
# クライアントのAF_UNIX対応有無ではなく、サーバの実装が決めることなので）。
_USE_TCP = sys.platform == "win32"
# "localhost" は環境によって ::1 を先に返し AF_INET のサーバへ繋がらないので使わない。
HOST = "127.0.0.1"

if _USE_TCP:
    # IX68K_MCP_PORT はWindows（TCP経路）でのみ意味を持つので、非Windowsでは
    # 検証しない（D10: 却下した代案「プラットフォームを問わずTCPを使う」の
    # 逆を行かないよう、この値の妥当性チェックもTCP経路限定にする）。
    try:
        DEFAULT_PORT = parse_port(os.environ.get("IX68K_MCP_PORT"), _DEFAULT_PORT)
    except ValueError as e:
        print(f"エラー: {e}", file=sys.stderr)
        sys.exit(1)
else:
    DEFAULT_PORT = _DEFAULT_PORT  # --helpの表示用。この値自体は使われない。

VERSION = "1.0"

STATE_NAMES = {
    0: "空",
    1: "Human68k側の `HOSTFILE GET` 待ち",
    2: "macOS側の `ix68k-hostfile get` 待ち",
}


# エミュレータ側 MCP_PROTO_VERSION（src/mcp/commands.c）と一致必須。
_PROTO_EXPECTED = 5
_clients = {}


def _client(endpoint) -> WireClient:
    """endpointごとにHELLO検証キャッシュを分離する。"""
    client = _clients.get(endpoint)
    if client is None:
        client = WireClient(endpoint)
        _clients[endpoint] = client
    return client


def send_command(endpoint, cmd: str, timeout: float = 30.0) -> str:
    """コマンドを1本送り、ステータス行を返す（このCLIが送るコマンドは
    いずれも本文バイト列を持たないテキスト応答なので、tag剥がし後の
    ヘッダ行だけを返せば十分）。endpoint はAF_UNIXならソケットパスの文字列、
    AF_INET(Windows, Issue #185)なら (host, port) のタプル。connect() は
    両方の形をそのまま受け取れる。"""
    try:
        client = _client(endpoint)
        if cmd == "HELLO":
            response = client._raw_send(Request(cmd), timeout)
        else:
            response = client.send(cmd, timeout)
        return response.status
    except WireError as e:
        print(
            f"エラー: {e}",
            file=sys.stderr,
        )
        sys.exit(1)


def _endpoint(args: argparse.Namespace):
    """文字列パス（AF_UNIX）または (host, port) タプル（AF_INET, Windows）を返す。"""
    if _USE_TCP:
        return (HOST, args.port)
    return args.sock


def cmd_put(args: argparse.Namespace) -> int:
    path = os.path.realpath(args.path)
    if not os.path.isfile(path):
        print(f"エラー: ファイルが見つかりません: {path}", file=sys.stderr)
        return 1
    status = send_command(_endpoint(args), f"HOSTFILE PUT {path}")
    if not status.startswith("OK "):
        print(f"エラー: {status}", file=sys.stderr)
        return 1
    size = status[3:]
    print(f"{size} バイトの送信準備ができました。")
    print("Human68k側で `HOSTFILE GET <出力ファイル名>` を実行してください。")
    return 0


def cmd_get(args: argparse.Namespace) -> int:
    path = os.path.realpath(args.path)
    status = send_command(_endpoint(args), f"HOSTFILE GET {path}")
    if status.startswith("ERR NOTREADY"):
        print("先に Human68k 側で `HOSTFILE PUT <入力ファイル名>` を実行してください。", file=sys.stderr)
        return 1
    if not status.startswith("OK "):
        print(f"エラー: {status}", file=sys.stderr)
        return 1
    size = status[3:]
    print(f"{size} バイトを {path} に書き出しました。")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    status = send_command(_endpoint(args), "HOSTFILE STATUS")
    if not status.startswith("OK "):
        print(f"エラー: {status}", file=sys.stderr)
        return 1
    parts = status[3:].split()
    state, length = int(parts[0]), int(parts[1])
    print(f"状態: {STATE_NAMES.get(state, state)} / 転送待ちのバイト数: {length}")
    return 0


def _make_output_safe():
    """日本語Windows等でstdout/stderrがcp932でも、ヘルプ内の記号等で落ちないようにする。"""
    for stream in (sys.stdout, sys.stderr):
        if hasattr(stream, "reconfigure"):
            stream.reconfigure(errors="replace")


def main() -> int:
    _make_output_safe()
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--version", action="version", version=f"ix68k-hostfile {VERSION}")
    # --sock と --port は常に両方定義する（sys.platformで出し分けない）。--helpの
    # 内容がプラットフォームで変わると、ドキュメントと実機の食い違いが起きやすい
    # （Issue #185 D11）。
    parser.add_argument("--sock", default=DEFAULT_SOCK,
                        help=f"ソケットパス（既定 {DEFAULT_SOCK}。Windowsでは無視される）")
    parser.add_argument("--port", default=None,
                        help=f"TCPポート番号（Windowsのみ。既定 {DEFAULT_PORT}）")
    sub = parser.add_subparsers(dest="command", required=True)

    p_put = sub.add_parser("put", help="macOSのファイルをHuman68k側へ送る（この後 Human68k側で HOSTFILE GET）")
    p_put.add_argument("path", help="送るファイルのパス")
    p_put.set_defaults(func=cmd_put)

    p_get = sub.add_parser("get", help="Human68k側が HOSTFILE PUT したファイルを受け取る")
    p_get.add_argument("path", help="保存先のパス")
    p_get.set_defaults(func=cmd_get)

    p_status = sub.add_parser("status", help="転送待ちの状態を表示")
    p_status.set_defaults(func=cmd_status)

    args = parser.parse_args()

    # プラットフォームに無関係な方を明示指定されたら、黙って無視せず警告する
    # （Issue #144 D4が排除しようとした失敗モード「別インスタンスを操作していた」
    # と同種、Issue #185 D11）。
    if _USE_TCP:
        if args.sock != DEFAULT_SOCK:
            print("警告: --sock はWindowsでは無視されます（TCPで接続します）。", file=sys.stderr)
        try:
            args.port = parse_port(args.port, DEFAULT_PORT)
        except ValueError as e:
            print(f"エラー: {e}", file=sys.stderr)
            return 1
    else:
        if args.port is not None:
            print("警告: --port はこのプラットフォームでは無視されます（AF_UNIXソケットを使用します）。",
                  file=sys.stderr)

    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
